# Copy to .env.local (local) or set in the hosting provider's environment settings. NEVER commit real values.
APP_URL=https://your-staging-url.example        # public https URL (used in QR links, cookies)
DATABASE_URL=                                   # managed Postgres connection string (Supabase/Neon). Leave empty locally to use embedded PGlite in ./data
VAPID_PUBLIC_KEY=                               # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sgia.sg
CRON_SECRET=                                    # random string; scheduler sends it as "Authorization: Bearer <value>"
